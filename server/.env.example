# Puerto del servidor (en el VPS será 3000 por defecto)
PORT=3000

# Supabase — Project Settings > API
# URL del proyecto: https://<tu-proyecto>.supabase.co
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Service Role Key (confidencial: NUNCA la expongas en el frontend ni en git)
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Conexión directa a Postgres (para npm run db:sql y --migrate).
# Supabase → Project Settings → Database → Connection string → URI
# → modo "Direct connection" (usuario postgres). Solo en el servidor
# local/VPS; jamás se expone al frontend.
SUPABASE_DB_URL=postgresql://postgres:TU-PASSWORD@db-TU-PROYECTO.supabase.co:5432/postgres

# Producción: restringe el CORS al dominio del frontend (si no está, la API
# queda abierta para desarrollo). Dominios separados por comas:
#   CORS_ORIGIN=https://tudominio.com,https://www.tudominio.com
# CORS_ORIGIN=
